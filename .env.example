# ============================================
# Hybrid AI Outreach Agent - Environment Config
# ============================================

# --- Environment ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./leadgenai.db

# --- Redis (Celery Broker) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SendGrid ---
SENDGRID_API_KEY=your-sendgrid-api-key

# --- SMTP (Gmail/Outlook fallback) ---
SMTP_DEFAULT_HOST=smtp.gmail.com
SMTP_DEFAULT_PORT=587

# --- WhatsApp Business API (Meta) ---
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# --- Twilio ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_DEFAULT_FROM_NUMBER=+1234567890

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# --- Tracking ---
TRACKING_BASE_URL=http://localhost:8000

# --- Rate Limits ---
EMAIL_RATE_PER_SECOND=1
EMAIL_DAILY_LIMIT_PER_ACCOUNT=500
WHATSAPP_BATCH_DELAY_SECONDS=2
MAX_CONCURRENT_CALLS=5

# --- Feature Flags ---
FEATURE_EMAIL_ENABLED=true
FEATURE_WHATSAPP_ENABLED=true
FEATURE_CALLS_ENABLED=true

# --- Sentry (Optional) ---
SENTRY_DSN=
